#two sum 
class Solution(object):
    def twoSum(self, nums, target):
        for i in range(len(nums)):
            for j in range(i+1,len(nums)):
                if nums[i]+nums[j]==target:
                    return [i, j]
#reverse string
class Solution(object):
    def reverseString(self, s):
        s.reverse()

#ispalindrome
class Solution(object):
    def isPalindrome(self, x):
        s=str(x)
        return s == s[::-1]
